# Copy this file to .env and fill in the values
# Never commit .env to git

# PostgreSQL
DB_USERNAME=orbital
DB_PASSWORD=changeme

# Space-Track credentials (https://www.space-track.org)
SPACETRACK_IDENTITY=your@email.com
SPACETRACK_PASSWORD=yourpassword

# Endpoint Space-Track. LAISSER COMMENTE dans le cas normal : chaque profil a
# deja le bon defaut --
#   dev / local -> https://for-testing-only.space-track.org  (on peut s'y
#                  tromper sans risquer un bannissement)
#   prd         -> https://www.space-track.org
# Ne decommenter que pour forcer l'autre endpoint ponctuellement : taper le
# vrai serveur depuis local, ou valider la prod sans consommer le quota.
# Decommentee, cette ligne surcharge le profil dans les deux sens.
#SPACETRACK_BASE_URL=https://for-testing-only.space-track.org

# Profil Spring.
#   dev   -> API/batch lances depuis l'IDE, seule la DB dans Docker
#            (docker compose -f docker-compose.db.yml up -d ; le profil se
#             regle alors dans la run configuration, pas ici)
#   local -> toute la stack dans Docker sur le poste de dev
#   prd   -> production (VPS)
SPRING_PROFILE=local

# Prefixe public sous lequel le frontend est servi. Doit finir par un "/".
#   dev local : /
#   prod VPS  : /orbital-track/   (https://romain-cotoni.fr/orbital-track/)
# Utilise a la fois par le --base-href du build Angular et par nginx.
BASE_PATH=/

# Port hote du frontend. 80 en prod ; 4200 (ou autre) en local si le 80 est pris.
FRONTEND_PORT=80

# Token Cesium Ion (https://ion.cesium.com). Injecte dans le bundle au build.
# Un token front est forcement visible par le navigateur : restreins-le par
# domaine cote Cesium Ion. Le garder ici le tient seulement hors de git.
CESIUM_TOKEN='your_cesium_ion_token'
