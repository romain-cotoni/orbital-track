# Template consomme par l'entrypoint de l'image nginx : au demarrage du
# conteneur, envsubst remplace ${BASE_PATH} par la valeur de la variable
# d'environnement du meme nom, puis ecrit le resultat dans
# /etc/nginx/conf.d/default.conf.
#
# BASE_PATH=/                -> l'app est servie a la racine (dev local)
# BASE_PATH=/orbital-track/  -> l'app est servie sous ce prefixe (prod VPS)
#
# Les variables nginx ($uri, $host, ...) ne sont PAS touchees par envsubst :
# l'entrypoint ne substitue que les noms presents dans l'environnement.
#
# Le build Angular a place les fichiers dans /usr/share/nginx/html${BASE_PATH},
# ce qui permet d'utiliser "root" partout, sans "alias" ni "rewrite".

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # WebSocket -- doit precede ${BASE_PATH}api/ pour matcher en premier.
    location ${BASE_PATH}api/ws {
        proxy_pass http://api:8080/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # API REST. Le backend expose toujours /api, quel que soit le prefixe public.
    location ${BASE_PATH}api/ {
        proxy_pass http://api:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA Angular : toute autre route renvoie index.html.
    location ${BASE_PATH} {
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }
}
